+          // Handle message passthrough by writing through display's writer.
+          // Nix's JSON logger forwards messages regardless of verbosity, so
+          // filtering is the monitor's job: pass through info and above, but
+          // keep trace-level chatter ("evaluating file ...", emitted at
+          // talkative when the producer runs with --verbose, as nh does) out
+          // of the raw output. handle_message still stores it in state.
+          if let cognos::Actions::Message { level, msg, .. } = &action
+            && *level <= cognos::Verbosity::Info
+          {
             writeln!(self.display.writer(), "{msg}").map_err(RomError::Io)?;
