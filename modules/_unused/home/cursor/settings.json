{
  // Usable defaults
  "window.newWindowProfile": "Default",
  "json.schemaDownload.enable": true,
  "terminal.integrated.defaultProfile.linux": "fish",
  "task.allowAutomaticTasks": "on",
  "editor.accessibilitySupport": "off",
  "security.workspace.trust.untrustedFiles": "open",
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  "git.alwaysSignOff": true,
  "git.blame.editorDecoration.enabled": true,
  "gitlens.currentLine.enabled": false,
  "git.blame.ignoreWhitespace": true,
  "git.enableCommitSigning": true,
  "git.useEditorAsCommitInput": false,
  "editor.codeLens": true,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,
  "explorer.confirmPasteNative": false,
  "files.autoGuessEncoding": true,
  "files.associations": { "*.json": "jsonc" }, // allows comments in json
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.gotoLocation.multipleDefinitions": "gotoAndPeek",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "workbench.editor.closeOnFileDelete": true,

  // THEME
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontLigatures": true,
  "editor.fontFamily": "'JetBrains Mono', 'monospace', monospace",
  "terminal.integrated.fontLigatures.enabled": true,

  // On save
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "files.autoSaveWhenNoErrors": true,
  "editor.formatOnSave": true,
  "editor.codeActions.triggerOnFocusChange": true,

  // Enhance diff view
  "diffEditor.ignoreTrimWhitespace": false, // ?
  "diffEditor.experimental.showMoves": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "diffEditor.codeLens": true,

  // JS/TS/CSS/HTML
  // Test this whole eslint configuration, i copy this from nextjs
  // "editor.codeActionsOnSave": {
  //   "source.fixAll.eslint": "always",
  //   "source.fixAll": "always"
  // },
  // "eslint.validate": ["javascript", "typescript", "typescriptreact"],
  // "eslint.lintTask.enable": true,
  // "eslint.run": "onType",
  // "typescript.tsserver.watchOptions": {
  //   "watchFile": "priorityPollingInterval"
  // },

  "editor.linkedEditing": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnPaste.enabled": true,
  "typescript.updateImportsOnPaste.enabled": true,
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferGoToSourceDefinition": true,
  "typescript.suggest.completeFunctionCalls": true,

  // Disable almost all inlay hints - they are too noisy
  "typescript.inlayHints.enumMemberValues.enabled": true, // good if you use enums
  "typescript.implementationsCodeLens.enabled": true,
  "typescript.implementationsCodeLens.showOnInterfaceMethods": true,
  "typescript.referencesCodeLens.enabled": false,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
  "javascript.inlayHints.functionLikeReturnTypes.enabled": false,
  "typescript.inlayHints.parameterTypes.enabled": false,
  "javascript.inlayHints.parameterTypes.enabled": false,
  "typescript.inlayHints.variableTypes.enabled": false,
  "javascript.inlayHints.variableTypes.enabled": false,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": false,
  "javascript.inlayHints.propertyDeclarationTypes.enabled": false,

  "typescript.format.enable": false, // use oxc instead
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "oxc.typeAware": true,
  "oxc.unusedDisableDirectives": "deny",
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[html]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },

  // NIX
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "[nix]": {
    "editor.defaultFormatter": "jnoortheen.nix-ide",
    "editor.formatOnSave": false,
  },
  "nix.serverSettings": {
    "nixpkgs": {
      "expr": "import (builtins.getFlake \"/home/qweered/hyprnixos\").inputs.nixpkgs { }",
    },
    "nixd": {
      "formatting": {
        "command": ["nix", "fmt"],
      },
      "options": {
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/qweered/hyprnixos\").nixosConfigurations.hyprnix.options.home-manager.users.type.getSubOptions []",
        },
        "flake-parts": {
          "expr": "(builtins.getFlake \"/home/qweered/hyprnixos\").debug.options",
        },
        // For a `perSystem` flake-parts option:
        "flake-parts2": {
          "expr": "(builtins.getFlake \"/home/qweered/hyprnixos\").currentSystem.options",
        },
      },
    },
  },

  "window.commandCenter": true,
  "vsicons.dontShowNewVersionMessage": true,
  // "workbench.editor.enablePreviewFromCodeNavigation": true,
  // "workbench.editor.limit.enabled": true,

  // "gitlens.rebaseEditor.openOnPausedRebase": false,

  // "vscode-neovim.compositeKeys": {
  //   "tt": {
  //     "command": "vscode-neovim.escape"
  //   }
  // }

  // For nextjs and similar
  "workbench.editor.customLabels.patterns": {
    "**/app/**/_layout.tsx": "${dirname} - Layout",
    "**/app/**/index.tsx": "${dirname} - Page",
    "**/app/**/index.ts": "${dirname} - Page",
    "**/app/**/layout.tsx": "${dirname} - Layout",
    "**/app/**/page.tsx": "${dirname} - Page",
    "**/app/**/route.tsx": "${dirname} - Route",
    "**/components/**/index.tsx": "${dirname} - Component",
  },
  // File nesting from antfu
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
